.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key
!*.example

# --- Build output ---
dist/
build/
out/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Testing / coverage ---
coverage/
.nyc_output/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

